{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartbioportal.org/schemas/expression_differential_result.schema.json",
  "title": "HeartBioPortal differential expression result row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "gene_id",
    "gene_symbol",
    "study_accession",
    "source_database",
    "disease_name",
    "phenotype_label_original",
    "contrast_name",
    "case_group_label",
    "control_group_label",
    "adjusted_p_value",
    "fdr_method",
    "direction",
    "significance_threshold",
    "analysis_method",
    "date_processed",
    "provenance_hash"
  ],
  "properties": {
    "gene_id": { "type": "string" },
    "gene_symbol": { "type": "string" },
    "gene_id_source": { "type": ["string", "null"] },
    "study_accession": { "type": "string" },
    "source_database": { "type": "string" },
    "source_url": { "type": ["string", "null"] },
    "assay_type": { "type": ["string", "null"] },
    "platform": { "type": ["string", "null"] },
    "species": { "type": ["string", "null"] },
    "tissue": { "type": ["string", "null"] },
    "cell_type": { "type": ["string", "null"] },
    "disease_id": { "type": ["string", "null"] },
    "disease_name": { "type": "string" },
    "phenotype_label_original": { "type": "string" },
    "phenotype_label_normalized": { "type": ["string", "null"] },
    "contrast_name": { "type": "string" },
    "case_group_label": { "type": "string" },
    "control_group_label": { "type": "string" },
    "n_case": { "type": ["integer", "null"], "minimum": 0 },
    "n_control": { "type": ["integer", "null"], "minimum": 0 },
    "log2_fold_change": { "type": ["number", "null"] },
    "p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "adjusted_p_value": { "type": "number", "minimum": 0, "maximum": 1 },
    "fdr_method": { "type": "string" },
    "direction": { "enum": ["up", "down", "not_significant"] },
    "significance_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "analysis_method": { "type": "string" },
    "analysis_package_version": { "type": ["string", "null"] },
    "preprocessing_method": { "type": ["string", "null"] },
    "covariates_used": { "type": ["array", "null"], "items": { "type": "string" } },
    "batch_correction_method": { "type": ["string", "null"] },
    "date_processed": { "type": "string" },
    "provenance_hash": { "type": "string" },
    "quality_score": { "type": ["number", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
